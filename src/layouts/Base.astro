---
import '@fontsource-variable/manrope';
import fontCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import fontLat from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Todo from '../components/Todo.astro';
import Icon from '../components/Icon.astro';
import Metrika from '../components/Metrika.astro';
import CookieBanner from '../components/CookieBanner.astro';
import LeadForm from '../components/LeadForm.astro';
import { BRAND, BRAND_NAME, CONTACTS, LEGAL, SITE_MODE } from '../data/site.js';
import { SERVICES } from '../data/services.js';
import { breadcrumbs } from '../lib/seo.js';
import { telHref } from '../lib/format.js';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  jsonLd?: (Record<string, unknown> | null)[];
  noindex?: boolean;
  form?: boolean;
  service?: string;
}
const { title, description, crumbs = [], jsonLd = [], noindex = false, form = true, service } = Astro.props;
const preview = SITE_MODE !== 'production';
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
// Бренд добавляем, пока title влезает в ~65 символов.
const branded = `${title} — ${BRAND_NAME}`;
const fullTitle = current === '/' || branded.length > 65 ? title : branded;
const schemas = [...jsonLd, breadcrumbs(Astro.site!.href.replace(/\/$/, ''), crumbs)].filter(Boolean);
const tel = telHref(CONTACTS.phoneE164 ?? CONTACTS.phone);
const messengers = [
  { href: CONTACTS.telegram, label: 'Telegram' },
  { href: CONTACTS.whatsapp, label: 'WhatsApp' },
  { href: CONTACTS.max, label: 'MAX' },
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2b3ae8" />
    <link rel="preload" href={fontCyr} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontLat} as="font" type="font/woff2" crossorigin />
    {(preview || noindex) ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    ))}
    <Metrika />
  </head>
  <body>
    <a class="skip" href="#main">К содержанию</a>
    <header class="header">
      <div class="wrap header-bar">
        <a class="brand" href="/">
          <span class="brand-mark"><Icon name="sparkles" size={20} /></span>
          <span class="brand-text">
            <span class="brand-name" data-todo={BRAND.name ? undefined : 'Название'}>{BRAND_NAME}</span>
            <span class="brand-tag">{BRAND.tagline}</span>
          </span>
        </a>
        <nav class="nav" aria-label="Основное меню">
          <details class="nav-services">
            <summary>Услуги <Icon name="chevron-down" size={16} /></summary>
            <ul>{SERVICES.map((s) => <li><a href={`/${s.slug}/`} aria-current={current === `/${s.slug}/` ? 'page' : undefined}><Icon name={s.icon} size={18} />{s.short}</a></li>)}</ul>
          </details>
          <a href="/ceny/">Цены</a>
          <a href="/garantii/">Гарантии</a>
          <a href="/kontakty/">Контакты</a>
        </nav>
        <div class="header-contact">
          {tel
            ? <a class="phone" href={tel}>{CONTACTS.phone}</a>
            : <span class="phone" data-todo="Телефон">+7 (343) ___-__-__</span>}
          <span class="hours" data-todo={CONTACTS.hours ? undefined : 'Часы работы'}>{CONTACTS.hours ?? 'часы работы'}</span>
        </div>
        <a class="btn btn-cta header-cta" href={form ? '#zayavka' : '/#zayavka'}>Оставить заявку</a>
      </div>
    </header>

    {crumbs.length > 1 && (
      <nav class="wrap crumbs" aria-label="Навигационная цепочка">
        {crumbs.map((c, i) => i < crumbs.length - 1 ? <><a href={c.path}>{c.name}</a><span aria-hidden="true"> / </span></> : <span>{c.name}</span>)}
      </nav>
    )}

    <main id="main">
      <slot />
      {form && <div class="wrap"><LeadForm service={service} /></div>}
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div>
          <a class="brand brand-footer" href="/">
            <span class="brand-mark"><Icon name="sparkles" size={20} /></span>
            <span class="brand-name">{BRAND_NAME}</span>
          </a>
          <p class="footer-tag">{BRAND.tagline}</p>
          <p class="footer-phone">{tel ? <a href={tel}>{CONTACTS.phone}</a> : <Todo label="Телефон" />}</p>
          <p class="messengers">
            {messengers.map((m) => m.href ? <a class="chip" href={m.href} data-goal="messenger_click" rel="noopener">{m.label}</a> : <Todo label={m.label} />)}
          </p>
        </div>
        <div>
          <p class="footer-title">Услуги</p>
          <ul>{SERVICES.map((s) => <li><a href={`/${s.slug}/`}>{s.short}</a></li>)}</ul>
        </div>
        <div>
          <p class="footer-title">Компания</p>
          <ul>
            <li><a href="/ceny/">Цены</a></li>
            <li><a href="/garantii/">Гарантии</a></li>
            <li><a href="/o-kompanii/">О компании</a></li>
            <li><a href="/kontakty/">Контакты и реквизиты</a></li>
          </ul>
        </div>
        <div class="requisites">
          <p class="footer-title">Реквизиты</p>
          <p>{LEGAL.fullName ?? <Todo label="ФИО ИП" />}</p>
          <p>ИНН {LEGAL.inn ?? <Todo label="ИНН" />}</p>
          <p>ОГРНИП {LEGAL.ogrnip ?? <Todo label="ОГРНИП" />}</p>
          <p><a href="/politika-pd/">Политика обработки персональных данных</a></p>
          <p><a href="/soglasie-pd/">Согласие на обработку персональных данных</a></p>
        </div>
      </div>
      <div class="wrap footer-note">Цены на сайте указаны «от» и не являются публичной офертой. Точную стоимость подтверждаем до выезда.</div>
    </footer>
    {tel && <a class="sticky-call" href={tel}><Icon name="phone" size={18} /> Позвонить</a>}
    <CookieBanner />
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --ink: #14172b; --muted: #5d6178; --line: #e6e8f2;
    --r: 18px; --r-sm: 12px; --wrap: 1180px;
    --shadow: 0 1px 2px rgba(20,23,43,.04), 0 8px 24px rgba(20,23,43,.06);
    --shadow-lg: 0 2px 4px rgba(20,23,43,.04), 0 24px 48px rgba(20,23,43,.10);
    --font: 'Manrope Variable', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  /* Палитра «ультрамарин + лимон» (выбор заказчика 2026-11-25) */
  :root {
    --primary: #2b3ae8; --primary-dark: #1f2cc4; --primary-2: #5b68ff;
    --soft: #f4f5ff; --mint: #e7e9ff; --glow-1: #dfe3ff; --glow-2: #fff6cc; --hero-bg: #fbfbff;
    --cta: #ffd23f; --cta-dark: #ffc400; --cta-ink: #14172b; --cta-shadow: rgba(255,196,0,.35);
    --deep-1: #2b3ae8; --deep-2: #1a1f8f; --footer: #12143a;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scrollbar-gutter: stable; }
  @view-transition { navigation: auto; }
  ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .18s; }
  body { margin: 0; font: 400 17px/1.6 var(--font); color: var(--ink); background: var(--bg); -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; height: auto; }
  a { color: var(--primary); }
  h1, h2, h3 { line-height: 1.15; margin: 0 0 .5em; letter-spacing: -.02em; font-weight: 800; }
  h1 { font-size: clamp(32px, 5.2vw, 56px); }
  h2 { font-size: clamp(28px, 3.8vw, 42px); margin-top: 1.4em; margin-bottom: .6em; }
  h3 { font-size: 20px; letter-spacing: -.01em; }
  .icon { flex: none; vertical-align: middle; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 32px; }
  .section { padding: 112px 0; }
  .section-soft { background: var(--soft); }
  .section h2:first-child, .section-head h2 { margin-top: 0; }
  .section-head { max-width: 680px; margin-bottom: 48px; }
  .section-head p { color: var(--muted); font-size: 19px; margin: 0; line-height: 1.6; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; color: var(--primary); background: var(--mint); padding: 6px 12px; border-radius: 999px; margin-bottom: 16px; }
  .skip { position: absolute; left: -9999px; } .skip:focus { left: 16px; top: 8px; z-index: 50; background: #fff; padding: 8px; }

  /* Заглушки: заметно, но не кричит */
  .todo { display: inline-flex; align-items: center; gap: 2px; border: 1.5px dashed #d9a400; color: #8a6a00; background: #fffbea; border-radius: 6px; padding: 0 .4em; font-size: .85em; font-weight: 600; white-space: nowrap; line-height: 1.5; }
  div.todo { display: block; padding: 14px 16px; white-space: normal; margin: 12px 0; border-radius: var(--r-sm); font-weight: 500; }
  [data-todo]:not(.todo) { outline: 1.5px dashed #d9a400; outline-offset: 3px; border-radius: 4px; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; border-radius: 999px; background: var(--primary); color: #fff; padding: 14px 26px; font: 700 16px var(--font); text-decoration: none; cursor: pointer; transition: transform .15s, background .15s, box-shadow .15s; }
  .btn:hover { background: var(--primary-dark); transform: translateY(-1px); }
  .btn-cta { background: var(--cta); color: var(--cta-ink); box-shadow: 0 8px 20px var(--cta-shadow); }
  .btn-cta:hover { background: var(--cta-dark); }
  .btn-ghost { background: #fff; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line); }
  .btn-ghost:hover { background: var(--soft); }
  .chip { display: inline-flex; padding: 6px 14px; border-radius: 999px; border: 1px solid rgba(255,255,255,.2); text-decoration: none; }

  .header { background: rgba(255,255,255,.92); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
  .header-bar { display: flex; align-items: center; gap: 36px; min-height: 92px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .brand-mark { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(135deg, var(--primary-2), var(--primary)); color: #fff; box-shadow: 0 6px 14px var(--mint); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name { font-weight: 800; font-size: 22px; letter-spacing: -.02em; }
  .brand-tag { font-size: 12px; color: var(--muted); }
  .nav { display: flex; gap: 32px; align-items: center; margin-left: auto; }
  .nav > a, .nav summary { color: var(--ink); text-decoration: none; font-weight: 600; font-size: 15px; cursor: pointer; }
  .nav > a:hover, .nav summary:hover { color: var(--primary); }
  .nav summary { list-style: none; display: inline-flex; align-items: center; gap: 4px; }
  .nav summary::-webkit-details-marker { display: none; }
  .nav-services { position: relative; }
  .nav-services ul { position: absolute; top: calc(100% + 18px); left: -16px; background: #fff; border: 1px solid var(--line); border-radius: var(--r); list-style: none; padding: 8px; margin: 0; min-width: 280px; box-shadow: var(--shadow-lg); }
  .nav-services li a { display: flex; align-items: center; gap: 10px; padding: 10px 12px; text-decoration: none; color: var(--ink); border-radius: 10px; font-weight: 600; font-size: 15px; }
  .nav-services li a .icon { color: var(--primary); }
  .nav-services li a:hover, .nav-services li a[aria-current] { background: var(--soft); }
  .header-contact { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.25; }
  .phone { font-weight: 800; font-size: 18px; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .hours { font-size: 12px; color: var(--muted); }
  .crumbs { font-size: 14px; color: var(--muted); padding-top: 28px; }
  .crumbs a { color: var(--muted); text-decoration: none; } .crumbs a:hover { color: var(--primary); }

  .footer { background: var(--footer); color: #b5b9cf; padding: 96px 0 36px; font-size: 15px; }
  .footer a { color: #eceefa; text-decoration: none; } .footer a:hover { color: #fff; text-decoration: underline; }
  .footer ul { list-style: none; padding: 0; margin: 0; } .footer li { margin: 8px 0; }
  .footer-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1.3fr; gap: 48px; }
  .brand-footer { color: #fff; margin-bottom: 12px; }
  .brand-footer .brand-name { color: #fff; }
  .footer-tag { margin: 0 0 16px; }
  .footer-phone { font-size: 20px; font-weight: 800; margin: 0 0 12px; }
  .footer-title { font-weight: 700; color: #fff; margin: 0 0 12px; }
  .footer p { margin: 0 0 8px; }
  .messengers { display: flex; gap: 8px; flex-wrap: wrap; }
  .footer .todo { background: transparent; color: #f3d26b; border-color: #8a7a3a; }
  .footer-note { margin-top: 40px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.08); font-size: 13px; color: #7f9996; }
  .sticky-call { display: none; }
  .cookie { position: fixed; left: 16px; right: 16px; bottom: 16px; max-width: 560px; background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 18px; box-shadow: var(--shadow-lg); z-index: 40; font-size: 14px; }
  .cookie p { margin: 0 0 12px; } .cookie-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  @media (max-width: 1000px) {
    .header-bar { flex-wrap: wrap; gap: 14px 20px; padding-top: 18px; padding-bottom: 12px; min-height: 0; }
    .nav { order: 3; width: 100%; margin-left: 0; overflow-x: auto; gap: 20px; padding-bottom: 4px; }
    .nav-services ul { top: calc(100% + 10px); }
    .header-cta { display: none; }
    .header-contact { margin-left: auto; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    body { font-size: 16px; }
    .wrap { padding: 0 20px; }
    .section { padding: 72px 0; }
    .brand-tag { display: none; }
    .brand-mark { width: 36px; height: 36px; }
    .brand-name { font-size: 20px; }
    .phone { font-size: 15px; }
    .footer-grid { grid-template-columns: 1fr; }
    .sticky-call { display: flex; align-items: center; justify-content: center; gap: 8px; position: fixed; left: 16px; right: 16px; bottom: 12px; z-index: 30; background: var(--cta); color: var(--cta-ink); font-weight: 800; padding: 15px; border-radius: 999px; text-decoration: none; box-shadow: 0 10px 24px var(--cta-shadow); }
    .footer { padding-top: 64px; padding-bottom: 104px; }
  }
</style>
