---
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import Icon from '../components/Icon.astro';
import Calculator from '../components/Calculator.astro';
import { SERVICES, serviceBySlug, priceFrom } from '../data/services.js';
import { BRAND_NAME, AREA } from '../data/site.js';
import { ADVANTAGES } from '../data/content.js';
import { service as serviceLd, faqPage } from '../lib/seo.js';
import { rub } from '../lib/format.js';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { service: s.slug } }));
}
const s = serviceBySlug(Astro.params.service)!;
const site = Astro.site!.href.replace(/\/$/, '');
const url = new URL(`/${s.slug}/`, Astro.site).href;
const from = priceFrom(s);
const p = s.price ?? {};
const cap = (t: string) => t[0].toUpperCase() + t.slice(1);
type Row = { label: string; value: string | null; todo: string };
const rows: Row[] = [
  ...(p.rooms ? [1, 2, 3].map((n) => ({ label: `${n}-комнатная квартира`, value: p.rooms[n] != null ? `от ${rub(p.rooms[n])}` : null, todo: 'цена' })) : []),
  ...('perM2' in p ? [{ label: p.rooms ? 'Большие квартиры, за 1 м²' : 'За 1 м²', value: p.perM2 != null ? `от ${rub(p.perM2)}` : null, todo: 'цена за м²' }] : []),
  ...(p.unit ? [{ label: cap(p.unit.label), value: p.unit.price != null ? `от ${rub(p.unit.price)}` : null, todo: 'цена' }] : []),
  ...('balcony' in p ? [{ label: 'Балкон или лоджия', value: p.balcony != null ? `от ${rub(p.balcony)}` : null, todo: 'цена' }] : []),
  ...('subscription' in p ? [{ label: 'Регулярная уборка', value: p.subscription ?? null, todo: 'условия абонемента' }] : []),
];
const related = s.related.map(serviceBySlug).filter(Boolean);
---
<Base
  title={s.title}
  description={s.description}
  service={s.slug}
  crumbs={[{ name: 'Главная', path: '/' }, { name: s.short, path: `/${s.slug}/` }]}
  jsonLd={[serviceLd({ site, brand: BRAND_NAME, name: s.h1, description: s.description, url, price: from }), faqPage(s.faq)]}
>
  <section class="svc-hero">
    <div class="wrap svc-hero-grid">
      <div>
        <span class="eyebrow"><Icon name={s.icon} size={16} /> {s.short}</span>
        <h1>{s.h1}</h1>
        <p class="m-price">{from ? <>от {rub(from.value)}{from.suffix}</> : <Todo label="цена" />} <a href="#kalkulyator">рассчитать</a></p>
        <p class="lead-text">{s.intro}</p>
        <ul class="facts">
          <li><Icon name="clock" size={18} /><span><small>Длительность</small>{s.duration ?? <Todo label="часы" />}</span></li>
          <li><Icon name="users" size={18} /><span><small>Бригада</small>{s.team ?? <Todo label="человек" />}</span></li>
          <li><Icon name="spray-can" size={18} /><span><small>Средства</small>наши</span></li>
        </ul>
      </div>
      <aside class="buy-card">
        <span class="buy-label">Стоимость</span>
        <span class="buy-price">{from ? <>от {rub(from.value)}<small>{from.suffix}</small></> : <Todo label="цена «от»" />}</span>
        <a class="btn btn-cta" href="#zayavka">Оставить заявку</a>
        <a class="btn btn-ghost" href="#kalkulyator"><Icon name="calculator" size={18} /> Рассчитать</a>
        <span class="buy-note">Цену подтверждаем до выезда</span>
      </aside>
    </div>
  </section>

  <div class="wrap">
    {s.draft && <Todo quiet label="Состав работ и ответы — черновик, согласовать с заказчиком" />}

    <section class="block">
      <h2>Цены</h2>
      <div class="price-rows">
        {rows.map((r) => <div class="price-row"><span>{r.label}</span><b>{r.value ?? <Todo label={r.todo} />}</b></div>)}
      </div>
      <p class="muted">Минимальный заказ — {AREA.minOrder != null ? rub(AREA.minOrder) : <Todo label="сумма" />}. Выезд за город — {AREA.suburbFee ?? <Todo label="условия" />}.</p>
    </section>

    <section class="block">
      <h2>Что входит</h2>
      <div class="checklist">
        {s.checklist.map((block) => (
          <div class="check-block">
            <h3>{block.area}</h3>
            {block.items
              ? <ul>{block.items.map((i) => <li><Icon name="check" size={18} /><span>{i}</span></li>)}</ul>
              : <Todo inline={false} label="состав работ" />}
          </div>
        ))}
      </div>
      {s.notIncluded && (
        <div class="not-included">
          <b>Не входит:</b> {s.notIncluded.join('; ')}.
        </div>
      )}
    </section>

    {ADVANTAGES && (
      <section class="block">
        <ul class="adv-mini">{ADVANTAGES.map(([icon, title]) => <li><Icon name={icon} size={20} /> {title}</li>)}</ul>
      </section>
    )}
  </div>

  <section class="section section-soft">
    <div class="wrap"><Calculator selected={s.slug} /></div>
  </section>

  <div class="wrap">
    <Todo quiet label="Фото «до/после» с наших объектов" />
    <Todo quiet label="Отзывы по услуге со ссылками на Карты/2ГИС" />

    <section class="block">
      <h2>Вопросы и ответы</h2>
      <div class="faq">
        {s.faq.map(({ q, a }) => (
          <details>
            <summary>{q}<Icon name="chevron-down" size={20} /></summary>
            {a ? <p>{a}</p> : <Todo inline={false} label="ответ" />}
          </details>
        ))}
      </div>
    </section>

    {related.length > 0 && (
      <section class="block">
        <h2>Ещё может пригодиться</h2>
        <div class="related">
          {related.map((r) => (
            <a href={`/${r.slug}/`}><span class="rel-icon"><Icon name={r.icon} size={22} /></span><span><b>{r.short}</b><small>{r.lead}</small></span><Icon name="arrow-right" size={18} /></a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .svc-hero { padding: 32px 0 80px; background: radial-gradient(800px 360px at 90% 0%, var(--glow-1) 0%, transparent 60%), var(--hero-bg); border-bottom: 1px solid var(--line); }
  .svc-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 80px; align-items: center; padding-top: 32px; }
  .lead-text { font-size: 19px; color: var(--muted); max-width: 640px; }
  .facts { display: flex; flex-wrap: wrap; gap: 12px; list-style: none; padding: 0; margin: 24px 0 0; }
  .facts li { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 10px 16px; font-weight: 700; }
  .facts .icon { color: var(--primary); }
  .facts span { display: flex; flex-direction: column; line-height: 1.25; }
  .facts small { font-size: 12px; color: var(--muted); font-weight: 600; }

  .buy-card { display: flex; flex-direction: column; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 24px; padding: 28px; box-shadow: var(--shadow-lg); }
  .buy-label { font-size: 14px; color: var(--muted); font-weight: 600; }
  .buy-price { font-size: 36px; font-weight: 800; letter-spacing: -.02em; line-height: 1.1; margin-bottom: 8px; }
  .buy-price small { font-size: 16px; font-weight: 600; color: var(--muted); margin-left: 4px; }
  .buy-note { font-size: 13px; color: var(--muted); text-align: center; }

  .block { margin-top: 96px; }
  .block h2 { margin-top: 0; }
  .price-rows { max-width: 720px; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
  .price-row { display: flex; justify-content: space-between; gap: 16px; padding: 16px 20px; border-bottom: 1px solid var(--line); }
  .price-row:nth-child(even) { background: var(--soft); }
  .price-row:last-child { border-bottom: 0; }
  .price-row b { white-space: nowrap; }
  .muted { color: var(--muted); font-size: 15px; }

  .checklist { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .check-block { border: 1px solid var(--line); border-radius: var(--r); padding: 32px; }
  .check-block ul { list-style: none; padding: 0; margin: 0; }
  .check-block li { display: flex; gap: 10px; margin: 10px 0; line-height: 1.45; }
  .check-block li .icon { color: var(--primary); margin-top: 2px; }
  .not-included { margin-top: 16px; background: #fff6f2; border-radius: var(--r-sm); padding: 14px 18px; color: #7a3b22; font-size: 15px; }

  .adv-mini { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 0; }
  .adv-mini li { display: inline-flex; align-items: center; gap: 8px; background: var(--mint); color: var(--primary-dark); font-weight: 700; padding: 10px 16px; border-radius: 999px; font-size: 15px; }

  .faq { max-width: 860px; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; font-weight: 700; font-size: 18px; cursor: pointer; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary .icon { color: var(--muted); transition: transform .2s; }
  .faq details[open] summary .icon { transform: rotate(180deg); }
  .faq details p { margin: 0 0 20px; color: var(--muted); }

  .related { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
  .related a { display: flex; align-items: center; gap: 14px; padding: 18px; border: 1px solid var(--line); border-radius: var(--r); text-decoration: none; color: var(--ink); transition: box-shadow .18s; }
  .related a:hover { box-shadow: var(--shadow-lg); }
  .related a > span:nth-child(2) { display: flex; flex-direction: column; flex: 1; }
  .related small { color: var(--muted); font-size: 14px; }
  .rel-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--mint); color: var(--primary); flex: none; }

  .m-price { display: none; }
  @media (max-width: 900px) {
    .svc-hero-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  }
  @media (max-width: 560px) {
    .block { margin-top: 64px; }
    .svc-hero { padding: 8px 0 48px; }
    .svc-hero-grid { padding-top: 16px; }
    .m-price { display: flex; align-items: baseline; gap: 12px; font-size: 26px; font-weight: 800; color: var(--primary); margin: 0 0 14px; }
    .m-price a { font-size: 15px; font-weight: 700; }
    .lead-text { font-size: 16px; }
    .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 18px; }
    .facts li { flex-direction: column; align-items: flex-start; gap: 4px; padding: 10px 12px; font-size: 14px; }
    .buy-card { padding: 20px; }
    .buy-price { font-size: 30px; }
    .price-row { padding: 14px 16px; font-size: 15px; }
    .check-block { padding: 18px; }
    .faq summary { font-size: 16px; }
  }
</style>
