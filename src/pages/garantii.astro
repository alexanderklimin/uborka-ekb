---
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
---
<Base title="Гарантии качества уборки" description="Что делаем, если результат уборки не понравился: переуборка, ответственность за имущество, договор."
  crumbs={[{ name: 'Главная', path: '/' }, { name: 'Гарантии', path: '/garantii/' }]}>
  <div class="wrap">
    <h1>Гарантии</h1>
    <h2>Если что-то не понравилось</h2>
    <Todo inline={false} label="Условия переуборки: в какой срок сообщить (например, 24 часа), что бесплатно, как фиксируем (фото)" />
    <h2>Если что-то повредили</h2>
    <Todo inline={false} label="Ответственность за имущество: возмещаем? есть ли страхование? лимит?" />
    <h2>Договор</h2>
    <Todo inline={false} label="Работаем по договору для всех или только для юрлиц? Есть публичная оферта?" />
    <h2>Кто приходит</h2>
    <Todo inline={false} label="Свои сотрудники или исполнители по договору, как проверяем, инструктаж" />
  </div>
</Base>
