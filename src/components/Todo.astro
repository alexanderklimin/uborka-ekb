---
// Заглушка для данных, которые должен дать заказчик.
// В превью видна пунктиром, `npm run build:production` с ней падает (scripts/check-placeholders.mjs).
// quiet — невидимая метка: блок в превью оформлен нейтрально, но production всё равно её найдёт.
interface Props { label: string; inline?: boolean; quiet?: boolean }
const { label, inline = true, quiet = false } = Astro.props;
const Tag = inline ? 'mark' : 'div';
---
{quiet ? <span hidden data-todo={label}></span> : <Tag class="todo" data-todo={label} title="Нужно от заказчика">⚑ {label}</Tag>}
