---
// Иконка Lucide, встраивается в HTML при сборке (без JS и внешних запросов).
import fs from 'node:fs';
import { createRequire } from 'node:module';
interface Props { name: string; size?: number; class?: string }
const { name, size = 24, class: cls } = Astro.props;
const require = createRequire(import.meta.url);
const file = require.resolve(`lucide-static/icons/${name}.svg`);
const svg = fs.readFileSync(file, 'utf8')
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/width="24"/, `width="${size}"`).replace(/height="24"/, `height="${size}"`)
  .replace(/class="[^"]*"/, `class="icon${cls ? ' ' + cls : ''}" aria-hidden="true" focusable="false"`)
  .trim();
---
<Fragment set:html={svg} />
