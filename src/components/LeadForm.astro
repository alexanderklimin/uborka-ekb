---
// Заявка: POST JSON на HTTP-триггер Cloud Function (yc-functions/lead), функция шлёт письмо.
// Согласие на ПДн отдельной галочкой со ссылкой на отдельный документ /soglasie-pd/ (152-ФЗ, ред. с 01.09.2025).
// В превью и без endpoint форма ничего не отправляет.
import { SERVICES } from '../data/services.js';
import { INTEGRATIONS, SITE_MODE } from '../data/site.js';
interface Props { service?: string; title?: string }
const { service, title = 'Оставьте заявку — перезвоним и назовём точную цену' } = Astro.props;
const endpoint = SITE_MODE === 'production' ? INTEGRATIONS.leadEndpoint : null;
const captchaKey = SITE_MODE === 'production' ? INTEGRATIONS.smartCaptchaKey : null;
---
<section class="lead" id="zayavka">
  <h2>{title}</h2>
  <form class="lead-form" data-endpoint={endpoint ?? ''} data-metrika={INTEGRATIONS.metrikaId ?? ''} novalidate>
    <div class="lead-grid">
      <label>Имя<input name="name" autocomplete="given-name" maxlength="80" /></label>
      <label>Телефон *<input name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="30" placeholder="+7" /></label>
      <label>Услуга
        <select name="service">
          <option value="">Не знаю, подскажите</option>
          {SERVICES.map((s) => <option value={s.slug} selected={s.slug === service}>{s.short}</option>)}
        </select>
      </label>
      <label>Площадь, м²<input name="area" type="number" inputmode="numeric" min="0" max="5000" /></label>
      <label>Желаемая дата<input name="date" type="date" /></label>
      <label class="lead-wide">Комментарий<textarea name="comment" rows="3" maxlength="1000"></textarea></label>
    </div>
    <label class="hp" aria-hidden="true">Не заполняйте<input name="website" tabindex="-1" autocomplete="off" /></label>
    <label class="consent">
      <input type="checkbox" name="consent" required />
      <span>Даю <a href="/soglasie-pd/" target="_blank">согласие на обработку персональных данных</a> в соответствии с <a href="/politika-pd/" target="_blank">политикой</a>.</span>
    </label>
    {captchaKey && <div class="smart-captcha" data-sitekey={captchaKey}></div>}
    <button class="btn" type="submit">Отправить заявку</button>
    <p class="lead-status" role="status"></p>
  </form>
  {captchaKey && <script is:inline src="https://smartcaptcha.yandexcloud.net/captcha.js" defer></script>}
</section>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.lead-form')) {
    const status = form.querySelector('.lead-status') as HTMLElement;
    const say = (text: string, ok = false) => { status.textContent = text; status.dataset.ok = String(ok); };

    document.addEventListener('calc:apply', (e: any) => {
      const { service, area, summary } = e.detail;
      (form.elements.namedItem('service') as HTMLSelectElement).value = service;
      if (area) (form.elements.namedItem('area') as HTMLInputElement).value = area;
      const comment = form.elements.namedItem('comment') as HTMLTextAreaElement;
      comment.value = `Калькулятор: ${summary}`;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const phoneDigits = String(fd.get('phone') ?? '').replace(/\D/g, '');
      if (phoneDigits.length < 10) return say('Проверьте номер телефона.');
      if (!fd.get('consent')) return say('Нужно согласие на обработку персональных данных.');

      const endpoint = form.dataset.endpoint;
      if (!endpoint) return say('Это превью: форма пока ничего не отправляет.');

      const payload: Record<string, unknown> = Object.fromEntries(fd.entries());
      payload.consent = true;
      payload.page = location.href;
      payload.attribution = (window as any).getAttribution?.() ?? {};
      const ymId = Number(form.dataset.metrika);
      const ym = (window as any).ym;
      if (ymId && ym) {
        payload.ym_client_id = await new Promise((resolve) => {
          const t = setTimeout(() => resolve(null), 800);
          ym(ymId, 'getClientID', (id: string) => { clearTimeout(t); resolve(id); });
        });
      }
      payload.captcha = (form.querySelector('[name="smart-token"]') as HTMLInputElement | null)?.value ?? '';

      const button = form.querySelector('button') as HTMLButtonElement;
      button.disabled = true;
      say('Отправляем…');
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error(String(res.status));
        say('Спасибо! Заявка отправлена, скоро перезвоним.', true);
        form.reset();
        (window as any).goal?.('form_submit');
      } catch {
        say('Не получилось отправить. Позвоните нам или напишите в мессенджер.');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .lead { position: relative; overflow: hidden; background: linear-gradient(135deg, var(--deep-1), var(--deep-2)); color: #fff; border-radius: 32px; padding: 64px; margin: 112px 0 0; scroll-margin-top: 100px; }
  .lead::after { content: ''; position: absolute; right: -120px; top: -120px; width: 360px; height: 360px; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,.14), transparent 70%); pointer-events: none; }
  .lead h2 { margin-top: 0; color: #fff; max-width: 720px; }
  .lead-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .lead label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: rgba(255,255,255,.78); }
  .lead input, .lead select, .lead textarea { width: 100%; min-width: 0; font: 500 16px var(--font); padding: 0 14px; height: 52px; border: 0; border-radius: 12px; background: #fff; color: var(--ink); }
  .lead textarea { height: auto; padding: 12px 14px; resize: vertical; }
  .lead input:focus, .lead select:focus, .lead textarea:focus { outline: 3px solid rgba(255,255,255,.4); }
  .lead-wide { grid-column: 1 / -1; }
  .lead .consent { flex-direction: row; align-items: flex-start; gap: 10px; margin: 18px 0 22px; color: rgba(255,255,255,.9); font-weight: 500; }
  .lead .consent input { margin-top: 3px; width: 20px; height: 20px; flex: none; accent-color: var(--cta); }
  .lead .consent a { color: #fff; }
  .lead .btn { background: var(--cta); color: var(--cta-ink); box-shadow: 0 10px 24px rgba(0,0,0,.2); }
  .lead .btn:hover { background: var(--cta-dark); }
  .hp { position: absolute; left: -9999px; }
  .lead-status { min-height: 1.5em; margin: 14px 0 0; font-weight: 700; color: #ffd2c2; }
  .lead-status[data-ok='true'] { color: #d9ffef; }
  @media (max-width: 800px) { .lead-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  @media (max-width: 560px) { .lead { padding: 32px 20px; border-radius: 24px; margin-top: 72px; } .lead-grid { grid-template-columns: minmax(0, 1fr); } .lead .btn { width: 100%; } }
</style>
