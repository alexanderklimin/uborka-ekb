{
  // ПРЕВЬЮ на Cloudflare Workers (static assets), как в hojapedia/tallerpedia.
  // Workers Builds: команда сборки `npm run build` (превью: noindex + Disallow + X-Robots-Tag), деплой `npx wrangler deploy`.
  // Боевой сайт — Yandex Cloud (`npm run build:production`), не здесь. Свой домен сюда не привязывать.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uborka-ekb-preview",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false
}
