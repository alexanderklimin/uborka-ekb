---
import Todo from '../components/Todo.astro';
import Metrika from '../components/Metrika.astro';
import CookieBanner from '../components/CookieBanner.astro';
import LeadForm from '../components/LeadForm.astro';
import { BRAND, BRAND_NAME, CONTACTS, LEGAL, SITE_MODE } from '../data/site.js';
import { SERVICES } from '../data/services.js';
import { breadcrumbs } from '../lib/seo.js';
import { telHref } from '../lib/format.js';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  jsonLd?: (Record<string, unknown> | null)[];
  noindex?: boolean;
  form?: boolean;
  service?: string;
}
const { title, description, crumbs = [], jsonLd = [], noindex = false, form = true, service } = Astro.props;
const preview = SITE_MODE !== 'production';
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
// Бренд добавляем, пока title влезает в ~65 символов.
const branded = `${title} — ${BRAND_NAME}`;
const fullTitle = current === '/' || branded.length > 65 ? title : branded;
const schemas = [...jsonLd, breadcrumbs(Astro.site!.href.replace(/\/$/, ''), crumbs)].filter(Boolean);
const tel = telHref(CONTACTS.phoneE164 ?? CONTACTS.phone);
const messengers = [
  { href: CONTACTS.telegram, label: 'Telegram' },
  { href: CONTACTS.whatsapp, label: 'WhatsApp' },
  { href: CONTACTS.max, label: 'MAX' },
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f5a54" />
    {(preview || noindex) ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    ))}
    <Metrika />
  </head>
  <body>
    {preview && <div class="preview-bar">Превью. Не для индексации. Жёлтым ⚑ отмечено то, что нужно от заказчика.</div>}
    <a class="skip" href="#main">К содержанию</a>
    <header class="header">
      <div class="wrap header-bar">
        <a class="brand" href="/">
          <span class="brand-name">{BRAND.name ?? <Todo label="Название" />}</span>
          <span class="brand-tag">{BRAND.tagline}</span>
        </a>
        <nav class="nav" aria-label="Основное меню">
          <details class="nav-services">
            <summary>Услуги</summary>
            <ul>{SERVICES.map((s) => <li><a href={`/${s.slug}/`} aria-current={current === `/${s.slug}/` ? 'page' : undefined}>{s.short}</a></li>)}</ul>
          </details>
          <a href="/ceny/">Цены</a>
          <a href="/garantii/">Гарантии</a>
          <a href="/kontakty/">Контакты</a>
        </nav>
        <div class="header-contact">
          {tel ? <a class="phone" href={tel}>{CONTACTS.phone}</a> : <Todo label="Телефон" />}
          {CONTACTS.hours ? <span class="hours">{CONTACTS.hours}</span> : <Todo label="Часы работы" />}
        </div>
        <a class="btn header-cta" href={form ? '#zayavka' : '/#zayavka'}>Оставить заявку</a>
      </div>
    </header>

    {crumbs.length > 1 && (
      <nav class="wrap crumbs" aria-label="Навигационная цепочка">
        {crumbs.map((c, i) => i < crumbs.length - 1 ? <><a href={c.path}>{c.name}</a><span aria-hidden="true"> / </span></> : <span>{c.name}</span>)}
      </nav>
    )}

    <main id="main">
      <slot />
      {form && <div class="wrap"><LeadForm service={service} /></div>}
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">{BRAND.name ?? <Todo label="Название" />}</p>
          <p>{BRAND.tagline}</p>
          <p>{tel ? <a href={tel}>{CONTACTS.phone}</a> : <Todo label="Телефон" />}</p>
          <p class="messengers">
            {messengers.map((m) => m.href ? <a href={m.href} data-goal="messenger_click" rel="noopener">{m.label}</a> : <Todo label={m.label} />)}
          </p>
        </div>
        <div>
          <p class="footer-title">Услуги</p>
          <ul>{SERVICES.map((s) => <li><a href={`/${s.slug}/`}>{s.short}</a></li>)}</ul>
        </div>
        <div>
          <p class="footer-title">Компания</p>
          <ul>
            <li><a href="/ceny/">Цены</a></li>
            <li><a href="/garantii/">Гарантии</a></li>
            <li><a href="/o-kompanii/">О компании</a></li>
            <li><a href="/kontakty/">Контакты и реквизиты</a></li>
          </ul>
        </div>
        <div class="requisites">
          <p class="footer-title">Реквизиты</p>
          <p>{LEGAL.fullName ?? <Todo label="ФИО ИП полностью" />}</p>
          <p>ИНН {LEGAL.inn ?? <Todo label="ИНН" />}</p>
          <p>ОГРНИП {LEGAL.ogrnip ?? <Todo label="ОГРНИП" />}</p>
          <p><a href="/politika-pd/">Политика обработки персональных данных</a></p>
          <p><a href="/soglasie-pd/">Согласие на обработку персональных данных</a></p>
        </div>
      </div>
      <div class="wrap footer-note">Цены на сайте указаны «от» и не являются публичной офертой. Точную стоимость подтверждаем до выезда.</div>
    </footer>
    {tel && <a class="sticky-call" href={tel}>Позвонить</a>}
    <CookieBanner />
  </body>
</html>

<style is:global>
  :root {
    --c-bg: #ffffff; --c-soft: #f2f6f5; --c-text: #17201f; --c-muted: #5b6866;
    --c-accent: #0f5a54; --c-accent-2: #e8f3f1; --c-line: #dbe3e1; --c-warn: #fff1a8;
    --r: 12px; --wrap: 1120px;
    --font: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; font: 17px/1.55 var(--font); color: var(--c-text); background: var(--c-bg); }
  img { max-width: 100%; height: auto; }
  a { color: var(--c-accent); }
  h1, h2, h3 { line-height: 1.2; margin: 0 0 .5em; }
  h1 { font-size: clamp(28px, 5vw, 44px); }
  h2 { font-size: clamp(22px, 3.4vw, 30px); margin-top: 1.6em; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 16px; }
  .skip { position: absolute; left: -9999px; } .skip:focus { left: 16px; top: 8px; z-index: 50; background: #fff; padding: 8px; }
  .todo { background: var(--c-warn); color: #5a4700; border-radius: 4px; padding: 0 .3em; font-size: .9em; white-space: nowrap; }
  div.todo { display: block; padding: .6em .8em; white-space: normal; margin: .5em 0; }
  .preview-bar { background: #2b2b2b; color: #fff; font-size: 13px; text-align: center; padding: 4px 16px; }
  .btn { display: inline-block; border: 0; border-radius: 10px; background: var(--c-accent); color: #fff; padding: 12px 20px; font: 600 16px var(--font); text-decoration: none; cursor: pointer; }
  .btn:hover { filter: brightness(1.1); }
  .btn-ghost { background: transparent; color: var(--c-accent); box-shadow: inset 0 0 0 2px var(--c-accent); }

  .header { border-bottom: 1px solid var(--c-line); background: #fff; position: sticky; top: 0; z-index: 20; }
  .header-bar { display: flex; align-items: center; gap: 20px; min-height: 64px; flex-wrap: wrap; padding-top: 8px; padding-bottom: 8px; }
  .brand { text-decoration: none; color: var(--c-text); display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name { font-weight: 800; font-size: 22px; color: var(--c-accent); }
  .brand-tag { font-size: 12px; color: var(--c-muted); }
  .nav { display: flex; gap: 18px; align-items: center; margin-left: auto; }
  .nav > a, .nav summary { color: var(--c-text); text-decoration: none; font-weight: 500; cursor: pointer; }
  .nav-services { position: relative; }
  .nav-services ul { position: absolute; top: 140%; left: 0; background: #fff; border: 1px solid var(--c-line); border-radius: var(--r); list-style: none; padding: 8px; margin: 0; min-width: 240px; box-shadow: 0 8px 24px rgba(0,0,0,.08); }
  .nav-services li a { display: block; padding: 6px 10px; text-decoration: none; color: var(--c-text); border-radius: 8px; }
  .nav-services li a:hover, .nav-services li a[aria-current] { background: var(--c-accent-2); }
  .header-contact { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.2; }
  .phone { font-weight: 700; font-size: 18px; color: var(--c-text); text-decoration: none; white-space: nowrap; }
  .hours { font-size: 12px; color: var(--c-muted); }
  .crumbs { font-size: 14px; color: var(--c-muted); padding-top: 12px; padding-bottom: 4px; }
  .crumbs a { color: var(--c-muted); }

  .footer { background: #10201e; color: #cfd9d7; margin-top: 64px; padding: 40px 0 24px; font-size: 15px; }
  .footer a { color: #fff; }
  .footer ul { list-style: none; padding: 0; margin: 0; } .footer li { margin: 4px 0; }
  .footer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .footer-brand { font-weight: 800; font-size: 20px; color: #fff; margin: 0 0 4px; }
  .footer-title { font-weight: 700; color: #fff; margin: 0 0 8px; }
  .footer p { margin: 0 0 6px; }
  .messengers { display: flex; gap: 12px; flex-wrap: wrap; }
  .footer-note { margin-top: 24px; font-size: 13px; color: #8fa19e; }
  .sticky-call { display: none; }
  .cookie { position: fixed; left: 16px; right: 16px; bottom: 16px; max-width: 560px; background: #fff; border: 1px solid var(--c-line); border-radius: var(--r); padding: 16px; box-shadow: 0 8px 32px rgba(0,0,0,.15); z-index: 40; font-size: 14px; }
  .cookie p { margin: 0 0 12px; } .cookie-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .nav { order: 3; width: 100%; margin-left: 0; overflow-x: auto; gap: 16px; }
    .header-cta { display: none; }
    .header-contact { margin-left: auto; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    body { font-size: 16px; }
    .brand-tag { display: none; }
    .footer-grid { grid-template-columns: 1fr; }
    .sticky-call { display: block; position: fixed; left: 16px; right: 16px; bottom: 12px; z-index: 30; text-align: center; background: var(--c-accent); color: #fff; font-weight: 700; padding: 14px; border-radius: 12px; text-decoration: none; box-shadow: 0 6px 18px rgba(0,0,0,.2); }
    .footer { padding-bottom: 80px; }
  }
</style>
