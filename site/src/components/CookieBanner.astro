---
import { INTEGRATIONS, SITE_MODE } from '../data/site.js';
// Баннер нужен, только когда есть что включать (Метрика в production).
const needed = SITE_MODE === 'production' && Boolean(INTEGRATIONS.metrikaId);
---
{needed && (
  <div class="cookie" id="cookie" hidden>
    <p>Мы используем cookie и Яндекс Метрику, чтобы понимать, как улучшить сайт. Подробнее в <a href="/politika-pd/">политике обработки персональных данных</a>.</p>
    <div class="cookie-actions">
      <button type="button" class="btn" data-consent="all">Принять</button>
      <button type="button" class="btn btn-ghost" data-consent="necessary">Только необходимые</button>
    </div>
  </div>
)}
<script>
  const box = document.getElementById('cookie');
  if (box) {
    let saved = null;
    try { saved = localStorage.getItem('cookie-consent'); } catch {}
    if (!saved) box.hidden = false;
    box.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-consent]') as HTMLElement | null;
      if (!btn) return;
      const value = btn.dataset.consent!;
      try { localStorage.setItem('cookie-consent', value); } catch {}
      box.hidden = true;
      if (value === 'all') (window as any).loadMetrika?.();
    });
  }
</script>
